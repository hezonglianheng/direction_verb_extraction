// 每组仅 words/examples；每条例句仅 sentence/instruction。
// 按实际关注词精确匹配，原句和替换句各选自己的示例；不限制每组例句条数。
[
  {
    words: ["里", "里面", "里边", "里头", "中", "内"],
    examples: [
      {sentence: "杯子里盛着一些水。", instruction: "当需要描述的实体位于一个三维容器的内部时，area 使用“[+容器内]”。"},
      {sentence: "一群人站在操场里。", instruction: "当需要描述的实体位于一个空间区域之内，或者位于该空间区域的边界内时，area 使用“[+边界内]”。"},
      {sentence: "这个房间里有一张桌子。", instruction: "竖直、水平方向没有明显的相对位置关系时，vertical_direction 和 horizontal_direction 使用“[无]”；实体被参照物容纳时，distance 使用“[无]”。"},
    ],
  },
  {
    words: ["外", "外面", "外边", "外头"],
    examples: [
      {sentence: "这个房间外面有一张桌子。", instruction: "当需要描述的实体位于一个三维容器的外部时，area 使用“[-容器内]”。"},
      {sentence: "他站在围墙外面。", instruction: "当需要描述的实体位于一个空间区域的外部时，area 使用“[-边界内]”。"},
      {sentence: "他们通过线上教学和外面的老师互动。", instruction: "当需要描述的实体与参照物之间有一定的距离且较远时，distance 使用“[+远]”。是否属于本研究的空间义由前序筛选决定，不在标注阶段重判。"},
    ],
  },
  {
    words: ["上", "上面", "上边", "上头"],
    examples: [
      {sentence: "桌子上放着一个杯子。", instruction: "当需要描述的实体的高度高于参照物时，vertical_direction 使用“[+上方]”。"},
      {sentence: "海报贴在墙上", instruction: "当需要描述的实体附着在参照物表面时，distance 使用“[+紧连]”。"},
      {sentence: "蒋一轮靠在树上", instruction: "当需要描述的实体与参照物较为松散地接触时，distance 使用“[+邻接]”。"},
    ],
  },
  {words: ["下", "下面", "下边", "下头"], examples: [
    {sentence: "书放在桌子下面。", instruction: "当需要描述的实体的高度低于参照物时，vertical_direction 使用“[+下方]”。"},
  ]},
  {words: ["前", "前面", "前边", "前头"], examples: [
    {sentence: "他站在我前面。", instruction: "当需要描述的实体位于参照物的前方时，horizontal_direction 使用“[+前方]”。"},
  ]},
  {words: ["后", "后面", "后边", "后头"], examples: [
    {sentence: "我坐在他后面。", instruction: "当需要描述的实体位于参照物的后方时，horizontal_direction 使用“[+后方]”。"},
  ]},
  {words: ["左", "左边", "左面"], examples: [
    {sentence: "书架在教室的左边。", instruction: "当需要描述的实体位于参照物的左方时，horizontal_direction 使用“[+左方]”。"},
  ]},
  {words: ["右", "右边", "右面"], examples: [
    {sentence: "门在房间的右边。", instruction: "当需要描述的实体位于参照物的右方时，horizontal_direction 使用“[+右方]”。"},
  ]},
  {words: ["侧", "侧面", "旁", "旁边", "边"], examples: [
    {sentence: "他站在汽车的侧面。", instruction: "当需要描述的实体位于参照物的左侧或者右侧，但不能确定具体在哪一侧时，horizontal_direction 使用“[+侧面]”。如果可以确定具体的位置，则使用“[+左方]”或“[+右方]”。"},
    {sentence: "他站在大槐树的旁边。", instruction: "当需要描述的实体位于参照物周遭的某个位置，但不能确定具体的位置时，horizontal_direction 使用“[+四周]”。如果可以确定具体的位置，则使用“[+前方]”、“[+后方]”、“[+左方]”或“[+右方]”。"},
    {sentence: "桌子旁边有一把椅子。", instruction: "当需要描述的实体与参照物之间有一定的距离且较近时，distance 使用“[+近]”。"},
  ]},
]
