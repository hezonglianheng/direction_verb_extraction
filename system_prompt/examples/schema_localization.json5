[
  {words: ["里", "里面", "里边", "里头", "中", "内"], examples: [
    {sentence: "杯子里盛着一些水。", instruction: "水是目标物，杯子是容器参照物。当前候选中“里1”表达容器内部关系；结合本侧空间特征逐项比对，而不是只按词形选图式。"},
    {sentence: "一群人站在操场里。", instruction: "操场提供边界范围。区分容器内部与边界内部，比较“里2”及其命中条件。"},
  ]},
  {words: ["上", "上面", "上边", "上头"], examples: [
    {sentence: "桌子上放着一个杯子。", instruction: "杯子高于桌子，句意未给出水平方向关系；可比对“上11”的条件。不要把所有含“上”的句子都归为同一图式。"},
    {sentence: "灯挂在天花板上。", instruction: "灯附着在天花板表面却位于其竖直下方；结合特征比较“上21”，不能由“上”字机械推断为上方。"},
  ]},
  {words: ["下", "下面", "下边", "下头"], examples: [
    {sentence: "书放在桌子下面。", instruction: "目标物在参照物下方，比较“下1”的条件；若句意还表达水平关系，则同时检查其他候选的相应条件。"},
  ]},
  {words: ["外", "外面", "外边", "外头"], examples: [
    {sentence: "教室外面有一张课桌。", instruction: "关注词“外面”归属“外”组，候选命名使用组名。比较外部关系和距离特征是否符合“外1”。"},
  ]},
]
