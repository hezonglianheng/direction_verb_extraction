// 趋向动词图式表未填写时不虚构固定图式号，由模型按当前候选/命名规则选择。
[
  {words: ["进", "进去", "进来", "入"], examples: [
    {sentence: "小王走进房间。", instruction: "围绕由外到内的位移关系和本侧空间特征比较当前候选；没有编号图式时再按所属组名加编号命名，不借用方位词“里”的图式号。"},
  ]},
  {words: ["出", "出去", "出来"], examples: [
    {sentence: "小王走出房间。", instruction: "图式应体现从内部移向外部的路径；使用趋向动词候选表，不因为出现“房间”就选择静态容器内部图式。"},
  ]},
  {words: ["上", "上去", "上来", "下", "下去", "下来"], examples: [
    {sentence: "他走下山坡。", instruction: "区分向高处和向低处的位移，本词性关注动态路径，不能直接套用同形方位词的静态图式。"},
  ]},
]
