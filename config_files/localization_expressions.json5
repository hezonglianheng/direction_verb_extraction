// 包含搜索汉语方位词相关句子的条件
//
// 方位词（上/下/里/外/前/后/中/间/旁/东/西/南/北/左/右/内 及其双音节形式）在 LTP 中的词性为 nd；
// 处所名词（附近/周围/远处/街上）为 nl，不在本规则范围（如需一并收，把下面的 "_pos": "nd" 改为
// "_pos": ["nd", "nl"] 即可——_pos 支持传列表，多值取并集）。
//
// 词表由同目录的 locality_vocab.json5 提供（"_vocab_file" 保留字），整体替换该文件即可换词表，
// 本配置无需改动。筛选前的初筛词表会自动从本配置推导（含 _vocab_file 里的词），不必再传 -v。
//
// 实测（科普文章 907 个初筛后候选句）：
//   _vocab + _pos=nd                 37.60%
//   方位短语（有 ATT 修饰语）           33.08%
//   方位短语（ATT 修饰语为名词性成分）     21.17%
//   方位词自身承担 LOC                 2.43%
//   方位词作介词宾语 POB               11.03%
//   方位词作动词宾语 VOB                0.66%
//
// "_pos": "nd" 这一限制的代价（400 篇科普文章、5912 个候选句的抽样体检）：
//   含词表词（精确成词）的句子中，96.71% 至少有一个词表词被标为 nd，
//   其余 3.29% 完全没有 nd（是该词表词在此处被标成动词/量词/名词的用法，
//   如 上 作动词、下 作量词），把它们排除掉正是 _pos 约束的目的，不属于漏召。
//   逐词词性分布见 locality_vocab.json5 顶部注释。
//
// 两点标注事实（决定了三条规则为何要并用）：
// 1. LTP 对“介词+方位词”的句法标注不统一：同一个方位词可能被标成 POB/VOB/SBV/ADV
//    （例如 屋子里 的 里面 是 POB，书在桌子上 的 上 是 VOB，房间里很安静 的 里 是 SBV），
//    故不能只靠 _syntax 判定处所，需与 _semantic: "LOC" 并用。
// 2. 名词+方位词时，DEP 树与 SDP 树中两者的父子方向相反：
//      DEP: 在 ← 上 ← 桌子   （方位词是父节点，桌子是它的 ATT 子节点）
//      SDP: 在 ←LOC- 桌子 ←mDEPD- 上   （名词是父节点，处所角色由名词承担）
//    引擎只能约束“依存子节点”、无法约束“父节点”，故方位短语用 DEP 侧的 ATT 子节点判定。
{
    "locality_phrase": {
        // 判据一：方位短语——方位词作结构中心语，名词性成分作其定语
        // 命中示例：桌子上 / 屋子里面 / 村子东边 / 窗户前面 / 图书馆里 / 操场上
        "_vocab_file": "config_files/locality_vocab.json5",
        "_pos": "nd",
        "_link": {
            "has_nominal_modifier": {
                // _syntax: "ATT" 表示该子节点（本方位词的依存子节点）的依存标签是 ATT（定中关系），
                // _pos 限定该定语为名词性成分（n 普通名词、nh 人名、ni 机构名、nl 处所名词、
                // ns 地名、nt 时间名词、nz 其他专名、r 代词，如“我们之间”“我旁边”）
                "_syntax": "ATT",
                "_pos": ["n", "nh", "ni", "nl", "ns", "nt", "nz", "r"],
            },
        },
    },
    "locality_as_prep_object": {
        // 判据二：介词（在/从/往/向）+ 方位词，如 从门缝里 / 往外 / 屋里 / 向左
        // 注意 _syntax 写在规则节点上表示“本词的依存标签”，不能写进 _link：
        // POB 是方位词相对介词的角色，而不是方位词的子节点
        "_vocab_file": "config_files/locality_vocab.json5",
        "_pos": "nd",
        "_syntax": "POB",
    },
    "locality_as_locative_role": {
        // 判据三：方位词自身承担处所语义角色，如 西边 / 下面 / 后 / 左 / 东边
        "_vocab_file": "config_files/locality_vocab.json5",
        "_pos": "nd",
        "_semantic": "LOC",
    },

    // 备选判据（默认关闭，需要时取消注释）
    // 方位词作动词宾语，如 书在桌子上 的 上（LTP 标 VOB 而非 POB，实测仅 0.66%）
    // "locality_as_verb_object": {
    //     "_vocab_file": "config_files/locality_vocab.json5",
    //     "_pos": "nd",
    //     "_syntax": "VOB",
    // },
    // 上限对照：只按词表 + nd 判定、不做任何结构约束（实测约 46%，产出量约为上面的 1.3 倍）
    // "locality_any": {
    //     "_vocab_file": "config_files/locality_vocab.json5",
    //     "_pos": "nd",
    // },

    // _logic 是保留字，表示各规则之间的逻辑关系（不参与规则生成）。
    // "or_all"：命中多条规则时把**全部**命中的规则名都记进 filter_methods
    //（默认的 "or" 只记录第一条命中的规则，句子同时是方位短语和介词宾语时会丢掉一条信息）。
    "_logic": "or_all",
}
