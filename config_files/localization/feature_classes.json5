// 方位词空间特征类别。保留类别定义和可选标签；示例迁至独立文件，按关注词选择。
// 活跃示例：system_prompt/examples/feature_localization.json5。
// 每类 key 必须唯一，也供同目录 schema_table.json5 的 match 引用。
{
    "classes": [
        {
            "key": "area",
            "name": "范围",
            "description": "请判断该句子中目标物（关键词关联的空间方位表达中，被描述空间信息的实体）是否处于一个由参照物确定的空间范围内，以及这个空间范围究竟属于容纳一个物体的容器，还是表示一个空间区域的边界。",
            "values": ["[+容器内]", "[+边界内]", "[-容器内]", "[-边界内]"],
        },
        {
            "key": "vertical_direction",
            "name": "竖直方向",
            "description": "请判断该句子中目标物（关键词关联的空间方位表达中，被描述空间信息的实体）和参照物之间在竖直方向上的相对位置关系。",
            "values": ["[+上方]", "[+下方]", "[无]"],
        },
        {
            "key": "horizontal_direction",
            "name": "水平方向",
            "description": "请判断该句子中目标物和参照物之间在水平方向上的相对位置关系。目标物环绕参照物、四个水平方向（前、后、左、右）同时成立时，用“[+四周]”概括，不要再单判成其中某一个方向。",
            "values": ["[+前方]", "[+后方]", "[+左方]", "[+右方]", "[+侧面]", "[+四周]", "[无]"],
        },
        {
            "key": "distance",
            "name": "距离",
            "description": "请判断该句子中目标物（关键词关联的空间方位表达中，被描述空间信息的实体）和参照物之间的距离关系。",
            "values": ["[+邻接]", "[+紧连]", "[+近]", "[+远]", "[无]"],
        },
    ],
}
