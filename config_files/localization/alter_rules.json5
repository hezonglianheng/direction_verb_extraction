// 改写规则表（alter_agent 用，纯规则，不调 LLM）
//
// 作用：把语料里的方位词/趋向动词换成规则表里指定的另一个词，得到「原句 vs 改写句」这样的对子，
// 供后续 semantic / feature / schema / judge 四个 agent 判定两句意义是否相同。
//
// 结构：
//   "groups": [ {"words": [词, ...], "replacements": [词, ...]}, ... ]
//     每一组是一个对象，两个字段各管一件事：
//       words        命中这一组的关注词——待替换的词是其中之一时，这一组才生效；
//       replacements 要换成的词，程序把原句 index 处的关注词逐个换成其中每一个，
//                    并**排除关注词本身**（词表里写了它也会跳过）。
//     一个原句因此会产出多个待选句、也就会落成多条结果记录（记录里的
//     candidate.index / candidate.total 标明这是第几个待选句、共几个）。
//     句内**每个**目标词位置都参与替换（「他从山上掉到山谷里」的「上」与「里」各是一个位置，
//     见 spatial_tools.pick_focus_words），每个位置各出一批待选句，但**一条记录只改一个位置**，
//     句里其余目标词原样保留作参照；位置之间不组合。
//     同一个词出现在多组里时，各组产出的替换词并起来用；重复的替换词只保留先出现的那个。
//     若某个词的替换不想按组来（例如只想试一个特定词），在调用侧传 focus_word["replacement"]
//     覆盖即可（focus_word 是本记录要替换的那个位置上的词，由 spatial_tools.pick_focus_words
//     给出），此时该位置只产出一个待选句，且优先级高于本表。
//   "_placeholder": 仅作说明用，程序不读下划线开头的键。
//
// 填表提示：两列写成同一份词表，就是旧版的「同义词组」语义（组内任意词都能换成组内其他词）。
// 想让若干词形共用一套替换词、或只单向替换（如 A 能换 B、B 不换 A），就让两列不同。
//
// 注意：替换只作用于该位置 index 处的那个 token，节点 children（
// 定语等修饰成分）原位保留。因此 "硬件上" → 把 上 换成 中 得到 "硬件中"，
// 而不是整段重写。若某个替换会破坏原有的定语搭配，请把那个词单独放开、或改用整句改写规则。
//
// 组填得不对（组不是对象、缺 words / replacements、词表为空或有重复等）在构造 alter agent 时
// 就会报错（见 spatial_tools.validate_alter_rules）。本表留空时不产出任何待选句、applied 记为
// false，流水线在改写环节停下并如实记录（状态 alter_missed），不会产出一对毫无差异的句子。
// 跑批入口启动时会逐张打印配置表，本表为空会出一条警告。
// 另可用 spatial_runner.py --alter-rules <路径> 指定另一张表来跑对照实验。
{
    "groups": [
        // 单音节方位词
        // {"words": ["上", "下", "前", "后", "左", "右", "里", "外", "中", "旁", "边", "内"],
        //  "replacements": ["上", "下", "前", "后", "左", "右", "里", "外", "中", "旁", "边", "内"], },
        {"words": ["上", "下", "前", "后", "里", "外", "中", "旁", "边", "内"],
         "replacements": ["上", "下", "前", "后", "里", "外", "中", "旁", "边", "内"], },
        // 双音节方位词
        // {"words": ["上面", "下面", "前面", "后面", "左面", "右面", "里面", "外面", "中间", "旁边"],
        //  "replacements": ["上面", "下面", "前面", "后面", "左面", "右面", "里面", "外面", "中间", "旁边"], },
        {"words": ["上面", "下面", "前面", "后面", "里面", "外面", "中间", "旁边"],
         "replacements": ["上面", "下面", "前面", "后面", "里面", "外面", "中间", "旁边"], },
        // {"words": ["上边", "下边", "前边", "后边", "左边", "右边", "里边", "外边", "中间", "旁边"],
        //  "replacements": ["上边", "下边", "前边", "后边", "左边", "右边", "里边", "外边", "中间", "旁边"], },
        // {"words": ["上边", "下边", "前边", "后边", "里边", "外边", "中间", "旁边"],
        //  "replacements": ["上边", "下边", "前边", "后边", "里边", "外边", "中间", "旁边"], },
        {"words": ["上边", "下边", "前边", "后边", "里边", "外边"],
         "replacements": ["上边", "下边", "前边", "后边", "里边", "外边"], },
        // {"words": ["上头", "下头", "前头", "后头", "里头", "外头", "中间", "旁边"],
        //  "replacements": ["上头", "下头", "前头", "后头", "里头", "外头", "中间", "旁边"], },
        {"words": ["上头", "下头", "前头", "后头", "里头", "外头"],
         "replacements": ["上头", "下头", "前头", "后头", "里头", "外头"], },
        // 前后左右-东南西北
        {"words": ["东", "西", "南", "北", ],
         "replacements": ["东", "西", "南", "北", "前", "后", "左", "右"], },
        {"words": ["东面", "西面", "南面", "北面", ],
         "replacements": ["东面", "西面", "南面", "北面", "前面", "后面", "左面", "右面"], },
        {"words": ["东边", "西边", "南边", "北边", ],
         "replacements": ["东边", "西边", "南边", "北边", "前边", "后边", "左边", "右边"], },
        {"words": ["东头", "西头", "南头", "北头", ],
         "replacements": ["东头", "西头", "南头", "北头", "前头", "后头", "左头", "右头"], },
    ],
}
