// schema 表（schema_agent 用）
//
// 作用：给每个方位词/趋向动词收一批「图式」，用语义特征把句子判到其中一个。
// schema 名是**组名 + 编号**的形式（如「上12」「下1」）：编号只在本组内唯一、只是个标识，
// 不表示顺序；同形的方位词与趋向动词（如「上」）共用一个词条，靠 match 与 description
// 区分用法，description 里写清收的是哪一种用法。
//
// 结构：
//   "schemas": {
//       "<组名>": {
//           "words": ["<词形>", ...],    // 可选，与编号同级
//           "<编号>": {
//               "description": "这个图式覆盖什么用法。写给人看，也是 LLM 兜底时挑名字的唯一依据",
//               "match": [ ... ],            // 一组或多组命中条件，见下
//               "examples": ["例句", ...],   // 可选，给 LLM 兜底时参考
//           }
//       }
//   }
//
// 选图式的顺序（见 spatial_tools.schema_candidates / lookup_schema）：
//   1. **先按关注词排除**：只在上游传下来的那个关注词所属的那一组里找。别的组的图式结构上就
//      不可能是答案（「上12」与「下1」是两种不同的空间结构）。哪一组收这个关注词由该组的
//      {组名} ∪ words 决定：词条写了 words 时，关注词是它列出的任一词形（外面/外边/外头）都
//      算命中（组名总在其中，不必也不该把组名再抄进 words 一遍）；没写 words 的组只有组名
//      一个词形，于是逐字相等，不会把「上」的图式算给「上面」、「上面」的算给「上」。
//      名字一律用组名，判定表因此只需按类写一份，不必为每个词形各写一遍。
//   2. **再按特征匹配**：match 里列出的特征键在该句特征里全部命中即算命中（组内是「与」；
//      没列出的键不参与判断，所以只写关键特征即可，不必穷举全部类别）。
//   3. 一个图式往往对应**许多组**特征值：比如「外」的距离特征可以是 [+紧连]，也可以是
//      [+邻接]/[+近]/[+远]，于是 match 写成**列表**，组与组之间是「或」：
//          "match": [
//              {"area": ["[-容器内]"], "distance": ["[+紧连]"]},
//              {"area": ["[-容器内]"], "distance": ["[+邻接]"]},
//              {"area": ["[-容器内]"], "distance": ["[+近]"]},
//          ]
//      只写一组时可直接写成对象（"match": {"area": ["[+边界内]"]}），等价于只有一组。
//   4. 一个键给多个值（"distance": ["[+近]", "[+远]"]）表示该键取其中任一；上游一个特征也
//      可能传来多个备选值（feature_agent 每类返回的就是列表），两侧有交集即算命中。
//   5. 取收窄后**第一条**命中的图式，顺序即书写顺序：特殊用法写在前面、宽泛的写在后面。
//      编号不参与排序，写 1、2、3 只为了好认。
//   6. match 省略、写成空列表 `[]`、或写成 `[{}]` 的条目是**兜底**：只有同组的其他图式都
//      没命中时才采用。想让 LLM 去挑最接近的，就别写兜底条目。
//   7. 同组的所有图式都不命中时，schema_agent 把候选名单（名字 + description + 命中条件 +
//      例句）交给 LLM，让它挑一个最接近的，结果里 source 记成 "llm"；这一组下一条图式都没有
//      时退化为让 LLM 自由命名（按组名 + 编号），source 记成 "llm_free"。所以看一条结果的
//      source 就知道这个 schema 是查表来的还是模型给的。
//
// 写法约束（构造 schema_agent 时校验，写错当场报错，见 spatial_tools.validate_schema_table）：
//   - 组名里不能有数字（schema 名是「组名 + 编号」，词里带数字会与编号撞名）；
//   - 编号必须是数字，同一组下不能有重复编号（1 与 "1" 算重复）；
//   - match 的特征键必须出现在 feature_classes.json5 的类别里：写错一个键不会报错，
//     只会让这条图式永远匹配不上（整条静默失效），所以在这里挡住；
//   - words 必须是字符串列表（可省略，但别写空列表——与不写等价，是无声的空操作）、
//     每项非空且无空白、组内不重复；**一个词形只能归一组**，两组都收同一个词形要报错；
//   - words 写在组下、与编号同级，别写进某条图式里（写在图式里没人读它，等于没写）。
//     组名总是自己这一组的成员，不必也不该把组名再抄进 words 一遍；反过来，words 里写了
//     本语料类型词表外的词形（多半是错字）不会报错，只是那个词形永远当不成关注词、
//     这一条静默失效——跑批启动时会把这类词形点出来，发现提示就去核一下。
//
// 本表留空时每句都走 LLM 兜底（自由命名）。下面的「里」「外」是按上面的写法填的示例，按需删改
// ——「里」那一条刻意留着不带编号图式，正是为了让人看得见「只有 words 的组」长什么样。
{
    "schemas": {
        // 这一类暂时只占位（还没有编号图式）：关注词是「里面」等词形时走
        // 「归入「里」这一类，但这一类下还没有编号图式」那条路，由 LLM 按组名命名（里1）
        "里": {
            "words": ["里", "里面", "里边", "里头", "中", "内"],
            "1": {
                "description": "目标物在作为容器的参照物内部",
                "match": [
                    {
                        "area": ["[+容器内]"], 
                        "distance": ["[无]"]
                    },
                ], 
                "examples": ["杯子里盛着一些水", "教室里面有一张课桌"],
            }, 
            "2": {
                "description": "目标物在作为边界的参照物内部",
                "match": [
                    {
                        "area": ["[+边界内]"], 
                        "distance": ["[+紧连]", "[+邻接]", "[+近]"]
                    },
                ], 
                "examples": ["一群人站在操场里", "他站在围墙里"],
            },
        },
        "外": {
            // 外面 146 条、外边 8、外头 2：不声明 words 的话它们各自落到自由命名，
            // 名字与「外1」分成两类，判定表就得为每个词形各写一遍
            "words": ["外", "外面", "外边", "外头"],
            "1": {
                "description": "目标物在参照物外部、与之贴近或邻近（如“海报贴在大门外”）",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]"], 
                        "distance": ["[+紧连]", "[+邻接]", "[+近]"]
                    },
                ],
                "examples": ["海报贴在大门外", "教室外面有一张课桌"],
            },
        },
        "上": {
            "words": ["上", "上面", "上边", "上头"],
            "11": {
                "description": "目标物在参照物的竖直方向上方，且没有水平方向上的关系",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "vertical_direction": ["[+上方]"], 
                        "horizontal_direction": ["[无]"], 
                        "distance": ["[+紧连]", "[+邻接]", "[+近]", "[+远]"]
                    },
                ],  
                "examples": ["桌子上放着一个杯子", "书放在桌子上面"],
            },
            "12": {
                "description": "目标物在参照物的竖直方向上方，且有水平方向上的关系",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "vertical_direction": ["[+上方]"], 
                        "horizontal_direction": ["[+前方]", "[+后方]", "[+左方]", "[+右方]"], 
                        "distance": ["[+紧连]", "[+邻接]", "[+近]", "[+远]"]
                    },
                ],
                "examples": ["水井上面站着一个人"],
            }, 
            "13": {
                "description": "目标物在参照物的竖直方向上方，且位于作为容器的参照物的内部",
                "match": [
                    {
                        "area": ["[+容器内]"], 
                        "vertical_direction": ["[+上方]"], 
                        "horizontal_direction": ["[无]"], 
                        "distance": ["[无]"]
                    },
                ],
                "examples": ["火车上面有人"],
            },
            "21": {
                "description": "目标物附着于参照物表面，位于参照物的竖直下方", 
                "match": [
                    {
                        "area": ["[+边界内]"], 
                        "vertical_direction": ["[+下方]"],
                        "horizontal_direction": ["[无]"],
                        "distance": ["[+紧连]"],
                    }
                ], 
                "examples": ["灯挂在天花板上"],
            }, 
            "22": {
                "description": "目标物附着于参照物表面，位于参照物的水平方向上", 
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "horizontal_direction": ["[+前方]", "[+后方]", "[+左方]", "[+右方]"],
                        "distance": ["[+紧连]", "[+邻接]"],
                    }
                ], 
                "examples": ["灯挂在天花板上面"],
            },
        },
        "下": {
            "words": ["下", "下面", "下边", "下头"],
            "1": {
                "description": "目标物在参照物的竖直方向下方，且没有水平方向上的关系",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "vertical_direction": ["[+下方]"], 
                        "horizontal_direction": ["[无]"], 
                        "distance": ["[+紧连]", "[+邻接]", "[+近]", "[+远]"]
                    },
                ],
                "examples": ["书放在桌子下面", "地上有一张纸"],
            }, 
            "2": {
                "description": "目标物在参照物的竖直方向下方，且有水平方向上的关系", 
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "vertical_direction": ["[+下方]"], 
                        "horizontal_direction": ["[+前方]", "[+后方]", "[+左方]", "[+右方]"], 
                        "distance": ["[+紧连]", "[+邻接]", "[+近]", "[+远]"]
                    },
                ],
                "examples": ["树下有一个人"],
            }, 
            "3": {
                "description": "目标物在参照物的竖直方向下方，且位于作为容器的参照物的内部",
                "match": [
                    {
                        "area": ["[+容器内]"], 
                        "vertical_direction": ["[+下方]"], 
                        "horizontal_direction": ["[无]"], 
                        "distance": ["[无]"]
                    },
                ],
                "examples": ["水井下面有一个人"],
            },
        },
        "前": {
            "words": ["前", "前面", "前边", "前头"],
            "1": {
                "description": "目标物在参照物的水平方向前方",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "horizontal_direction": ["[+前方]"],
                        "distance": ["[+紧连]", "[+邻接]", "[+近]",]
                    },
                ],
                "examples": ["他站在我前面", "我坐在他前面"],
            },
            "2": {
                "description": "目标物在参照物内部的前部",
                "match": [
                    {
                        "area": ["[+容器内]"], 
                        "horizontal_direction": ["[+前方]"],
                        "distance": ["[无]"]
                    },
                ],
                "examples": ["他站在教室前面"],
            },
        },
        "后": {
            "words": ["后", "后面", "后边", "后头"],
            "1": {
                "description": "目标物在参照物的水平方向后方",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "horizontal_direction": ["[+后方]"],
                        "distance": ["[+紧连]", "[+邻接]", "[+近]"]
                    },
                ],
                "examples": ["我坐在他后面", "他站在我后面"],
            }, 
            "2": {
                "description": "目标物在参照物内部的后部",
                "match": [
                    {
                        "area": ["[+容器内]"], 
                        "horizontal_direction": ["[+后方]"],
                        "distance": ["[无]"]
                    },
                ],
                "examples": ["他站在教室后面"],
            },
        }, 
        "旁": {
            "words": ["旁", "旁边", "边"],
            "1": {
                "description": "目标物在参照物的水平方向上",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "horizontal_direction": ["[+前方]", "[+后方]", "[+左方]", "[+右方]"], 
                        "distance": ["[+紧连]", "[+邻接]", "[+近]"]
                    },
                ],
                "examples": ["孩子们在大树的旁边嬉戏"],
            },
            "2": {
                "description": "目标物在参照物的水平方向左方或右方",
                "match": [
                    {
                        "area": ["[-容器内]", "[-边界内]", "[+边界内]"], 
                        "horizontal_direction": ["[+左方]", "[+右方]"],
                        "distance": ["[+紧连]", "[+邻接]", "[+近]"]
                    },
                ],
                "examples": ["小明的座位在我的座位旁边"],
            },
        },
    },
}
